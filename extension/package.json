{
  "name": "focus-directory",
  "displayName": "Focus a Directory",
  "description": "Search directories in the current workspace and focus one in the file Explorer.",
  "version": "0.0.1",
  "publisher": "mills-git",
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/mills-git/vscode-focus-directory.git",
    "directory": "extension"
  },
  "bugs": {
    "url": "https://github.com/mills-git/vscode-focus-directory/issues"
  },
  "homepage": "https://github.com/mills-git/vscode-focus-directory#readme",
  "keywords": [
    "explorer",
    "directory",
    "folder",
    "search",
    "navigation",
    "focus"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "focusDirectory.focus",
        "title": "Focus a Directory"
      }
    ]
  },
  "scripts": {
    "compile": "tsc --noEmit -p ./ && node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "node esbuild.js --minify",
    "vscode:prepublish": "npm run package",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "test:coverage": "node --import tsx --test --experimental-test-coverage \"src/**/*.test.ts\""
  },
  "dependencies": {
    "ignore": "^5.3.2"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/vscode": "^1.85.0",
    "c8": "^12.0.0",
    "esbuild": "^0.23.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  }
}
